<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Tidal Studio @VERSION@</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
  <domains enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="12.0"/></allowed-os-versions></volume-check>
  <choices-outline>
    <line choice="default"><line choice="runtime"/><line choice="app"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="runtime" visible="false"><pkg-ref id="io.github.vsalesa.tidalstudio.runtime"/></choice>
  <choice id="app" visible="false"><pkg-ref id="io.github.vsalesa.tidalstudio.app"/></choice>
  <pkg-ref id="io.github.vsalesa.tidalstudio.runtime">runtime.pkg</pkg-ref>
  <pkg-ref id="io.github.vsalesa.tidalstudio.app">app.pkg</pkg-ref>
</installer-gui-script>
