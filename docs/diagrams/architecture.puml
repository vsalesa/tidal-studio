@startuml
!include style.iuml
title <size:20><b>How Tidal Studio works</b></size>

actor "You" as you
rectangle "<b>Browser</b>\nweb/ (vanilla JS)\nTracks · Blocks · Mix · Timeline\nArrangement · Code · Maestro chat" as web #fbe3db

frame "Your computer  (127.0.0.1)" {
  rectangle "<b>server/app.py</b>\nlocal web server\n(Python standard library)" as app
  rectangle "<b>server/engine.py</b>\nstarts GHCi and sclang" as engine
  rectangle "<b>GHCi + TidalCycles</b>\ntidal/BootTidal.hs\nd1 … d12" as tidal #dcefeb
  rectangle "<b>SuperCollider + SuperDirt</b>\nsupercollider/start_superdirt.scd\nsamples · synths · EQ" as sc #f8ecd2
  rectangle "<b>server/llm.py</b> + assistant.py\nMaestro's prompts and replies" as llm
  rectangle "<b>server/skills.py</b> + plugins.py\nskills/ · my-skills/ · my-plugins/" as skills
  rectangle "<b>server/samples.py</b> + fetcher.py\nsamples/ library\nMaestro fetches what is missing" as samples
  rectangle "<b>server/loops.py</b>\nlong loops: tempo, bars,\nkey, hits" as loops
  rectangle "<b>server/timeline.py</b>\nits own GHCi: queryArc\nfor the Timeline" as tl #dcefeb
  rectangle "<b>server/files.py</b> + songimport.py\n+ midigen.py: open/save .tidal,\nimport MIDI or audio,\ngenerate from your MIDI" as files
  rectangle "<b>server/ccdetect.py</b> + llmdiag.py\nfinds Claude Code,\nDiagnostics" as diag
  node "Speakers" as out
}

cloud "AI\nOpenAI-compatible · Claude API\nor the claude CLI (your plan)" as ai
cloud "GitHub · Freesound\nsample packs, your songs repo,\nskills and plugins" as gh

you --> web
web --> app : HTTP
app --> engine
engine --> tidal : code (stdin)
tidal --> sc : OSC :57120
sc --> out : audio
sc ..> app : notes playing\nOSC :57140\n(live highlighting)
app --> llm : chat
skills --> llm : matching skills
llm --> ai
app --> samples
samples --> sc : reload sounds\n(OSC /tidalstudio)
samples ..> gh
skills ..> gh
app --> loops
loops --> samples : every new sound\nis analysed
app --> tl : where does\neach hit play?
app --> files
llm --> diag
@enduml
