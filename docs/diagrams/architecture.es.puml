@startuml
!include style.iuml
title <size:20><b>Cómo funciona Tidal Studio</b></size>

actor "Tú" as you
rectangle "<b>Navegador</b>\nweb/ (vanilla JS)\nPistas · Bloques · Mezcla · Código\nchat con Maestro" as web #fbe3db

frame "Tu ordenador  (127.0.0.1)" {
  rectangle "<b>server/app.py</b>\nservidor web local\n(biblioteca estándar de Python)" as app
  rectangle "<b>server/engine.py</b>\narranca GHCi y sclang" as engine
  rectangle "<b>GHCi + TidalCycles</b>\ntidal/BootTidal.hs\nd1 … d12" as tidal #dcefeb
  rectangle "<b>SuperCollider + SuperDirt</b>\nsupercollider/start_superdirt.scd\nsamples · sintes · ecualizador" as sc #f8ecd2
  rectangle "<b>server/llm.py</b> + assistant.py\ninstrucciones y respuestas de Maestro" as llm
  rectangle "<b>server/skills.py</b> + plugins.py\nskills/ · my-skills/ · my-plugins/" as skills
  rectangle "<b>server/samples.py</b>\nbiblioteca samples/" as samples
  node "Altavoces" as out
}

cloud "AI\nOpenAI-compatible · Claude API\no el comando claude (tu plan)" as ai
cloud "GitHub · Freesound\npacks de samples, tu repo de canciones,\nskills y plugins" as gh

you --> web
web --> app : HTTP
app --> engine
engine --> tidal : código (stdin)
tidal --> sc : OSC :57120
sc --> out : sonido
sc ..> app : notas que suenan\nOSC :57140\n(resaltado en directo)
app --> llm : chat
skills --> llm : skills que encajan
llm --> ai
app --> samples
samples --> sc : recarga sonidos\n(OSC /tidalstudio)
samples ..> gh
skills ..> gh
@enduml
